# Harness API Configuration
# Get your API key from: https://app.harness.io/ng/account/[accountId]/settings/resources/apikeys

VITE_HARNESS_ACCOUNT_ID=your_account_id_here
VITE_HARNESS_API_KEY=your_api_key_here
VITE_HARNESS_BASE_URL=https://app.harness.io

# Application Configuration
VITE_APP_NAME=Harness Security Dashboard
VITE_CACHE_TTL_MS=300000

# Feature Flags
VITE_ENABLE_CISA_KEV=true
VITE_ENABLE_EPSS=true
VITE_ENABLE_EVIDENCE_EXPORT=true

# Demo Mode (uses mock data instead of real API calls)
VITE_DEMO_MODE=false
