import { useState, useMemo } from 'react';
import { useComponents } from '@/hooks/useComponentData';
import { config } from '@/lib/config';

export function ExposuresPage() {
  const [orgId] = useState('demo');
  const [projectId] = useState('Platform_Engineering');

  const { data: components = [], isLoading, error } = useComponents(orgId, projectId);

  // Filters
  const [searchTerm, setSearchTerm] = useState('');
  const [severityFilter, setSeverityFilter] = useState<string[]>([]);
  const [envFilter, setEnvFilter] = useState<'all' | 'prod' | 'non-prod'>('all');
  const [sortBy, setSortBy] = useState<'severity' | 'deployments' | 'services'>('severity');

  // Pagination
  const [currentPage, setCurrentPage] = useState(1);
  const [pageSize, setPageSize] = useState(50);

  // Filter and sort
  const filteredComponents = useMemo(() => {
    let filtered = [...components];

    // Search filter (package name)
    if (searchTerm) {
      const search = searchTerm.toLowerCase();
      filtered = filtered.filter(c =>
        c.package.toLowerCase().includes(search)
      );
    }

    // Severity filter
    if (severityFilter.length > 0) {
      filtered = filtered.filter(c =>
        severityFilter.includes(c.highestSeverity)
      );
    }

    // Environment filter
    if (envFilter === 'prod') {
      filtered = filtered.filter(c => c.hasProduction);
    } else if (envFilter === 'non-prod') {
      filtered = filtered.filter(c => !c.hasProduction);
    }

    // Sort
    if (sortBy === 'severity') {
      const severityOrder = { critical: 4, high: 3, medium: 2, low: 1, info: 0, unknown: -1 };
      filtered.sort((a, b) => {
        const aVal = severityOrder[a.highestSeverity as keyof typeof severityOrder] || -1;
        const bVal = severityOrder[b.highestSeverity as keyof typeof severityOrder] || -1;
        return bVal - aVal;
      });
    } else if (sortBy === 'deployments') {
      filtered.sort((a, b) => b.totalCurrentDeployments - a.totalCurrentDeployments);
    } else if (sortBy === 'services') {
      filtered.sort((a, b) => b.uniqueServices - a.uniqueServices);
    }

    return filtered;
  }, [components, searchTerm, severityFilter, envFilter, sortBy]);

  // Paginate
  const paginatedComponents = useMemo(() => {
    const startIdx = (currentPage - 1) * pageSize;
    const endIdx = startIdx + pageSize;
    return filteredComponents.slice(startIdx, endIdx);
  }, [filteredComponents, currentPage, pageSize]);

  const totalPages = Math.ceil(filteredComponents.length / pageSize);

  // Reset to page 1 when filters change
  useMemo(() => {
    setCurrentPage(1);
  }, [searchTerm, severityFilter, envFilter, sortBy]);

  if (isLoading) {
    return (
      <div className="card">
        <div className="flex items-center justify-center py-12">
          <div className="text-gray-500">Loading component exposures...</div>
        </div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="card">
        <div className="text-red-600">Error loading components: {(error as Error).message}</div>
      </div>
    );
  }

  const severityCounts = {
    critical: components.filter(c => c.highestSeverity === 'critical').length,
    high: components.filter(c => c.highestSeverity === 'high').length,
    medium: components.filter(c => c.highestSeverity === 'medium').length,
  };

  // Helper to generate Harness SBOM URL
  const getSBOMUrl = (component: typeof components[0]) => {
    if (!component.inArtifacts?.[0]?.sourceId || !component.inArtifacts?.[0]?.artifactId) return null;

    const baseUrl = config.harness.baseUrl;
    const accountId = config.harness.accountId;

    return `${baseUrl}/ng/account/${accountId}/module/ssca/orgs/${orgId}/projects/${projectId}/artifact-sources/${component.inArtifacts[0].sourceId}/artifacts/${component.inArtifacts[0].artifactId}/details/dependencies`;
  };

  return (
    <div className="space-y-6">
      {/* Header */}
      <div className="card">
        <h1 className="text-2xl font-bold text-gray-900 mb-2">Component Exposures</h1>
        <p className="text-gray-600 mb-4">
          Vulnerable packages and libraries across your services
        </p>

        {/* Summary Stats */}
        <div className="grid grid-cols-4 gap-4">
          <div>
            <div className="text-sm text-gray-500">Vulnerable Components</div>
            <div className="text-2xl font-bold text-gray-900">{components.length}</div>
          </div>
          <div>
            <div className="text-sm text-gray-500">Critical</div>
            <div className="text-2xl font-bold text-red-600">{severityCounts.critical}</div>
          </div>
          <div>
            <div className="text-sm text-gray-500">High</div>
            <div className="text-2xl font-bold text-orange-600">{severityCounts.high}</div>
          </div>
          <div>
            <div className="text-sm text-gray-500">In Production</div>
            <div className="text-2xl font-bold text-blue-600">
              {components.filter(c => c.hasProduction).length}
            </div>
          </div>
        </div>
      </div>

      {/* Filters */}
      <div className="card">
        <h2 className="text-lg font-semibold text-gray-900 mb-4">Filters</h2>
        <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
          {/* Search */}
          <div className="md:col-span-2">
            <label className="block text-sm font-medium text-gray-700 mb-2">
              Search Package (e.g., "log4j", "jackson")
            </label>
            <input
              type="text"
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
              placeholder="Package name..."
              className="w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500"
            />
          </div>

          {/* Severity */}
          <div>
            <label className="block text-sm font-medium text-gray-700 mb-2">Severity</label>
            <div className="space-y-2">
              {['critical', 'high', 'medium'].map(sev => (
                <label key={sev} className="flex items-center">
                  <input
                    type="checkbox"
                    checked={severityFilter.includes(sev)}
                    onChange={(e) => {
                      if (e.target.checked) {
                        setSeverityFilter([...severityFilter, sev]);
                      } else {
                        setSeverityFilter(severityFilter.filter(s => s !== sev));
                      }
                    }}
                    className="rounded border-gray-300 text-primary-600 focus:ring-primary-500"
                  />
                  <span className="ml-2 text-sm text-gray-700 capitalize">{sev}</span>
                </label>
              ))}
            </div>
          </div>

          {/* Environment */}
          <div>
            <label className="block text-sm font-medium text-gray-700 mb-2">Environment</label>
            <select
              value={envFilter}
              onChange={(e) => setEnvFilter(e.target.value as any)}
              className="w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500"
            >
              <option value="all">All</option>
              <option value="prod">Production Only</option>
              <option value="non-prod">Non-Prod Only</option>
            </select>
          </div>
        </div>

        <div className="mt-4 flex items-center justify-between">
          <div className="text-sm text-gray-600">
            Showing {Math.min((currentPage - 1) * pageSize + 1, filteredComponents.length)}-{Math.min(currentPage * pageSize, filteredComponents.length)} of {filteredComponents.length} components
          </div>
          <div className="flex items-center gap-4">
            <div className="flex items-center gap-2">
              <label className="text-sm font-medium text-gray-700">Per page:</label>
              <select
                value={pageSize}
                onChange={(e) => {
                  setPageSize(Number(e.target.value));
                  setCurrentPage(1);
                }}
                className="rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500"
              >
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
              </select>
            </div>
            <div className="flex items-center gap-2">
              <label className="text-sm font-medium text-gray-700">Sort by:</label>
              <select
                value={sortBy}
                onChange={(e) => setSortBy(e.target.value as any)}
                className="rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500"
              >
                <option value="severity">Severity</option>
                <option value="deployments">Deployments</option>
                <option value="services">Services</option>
              </select>
            </div>
          </div>
        </div>
      </div>

      {/* Components Table */}
      <div className="card overflow-hidden">
        <div className="overflow-x-auto">
          <table className="min-w-full divide-y divide-gray-200">
            <thead className="bg-gray-50">
              <tr>
                <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Package
                </th>
                <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Version
                </th>
                <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Vulnerabilities
                </th>
                <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Services
                </th>
                <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Environments
                </th>
                <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Evidence
                </th>
              </tr>
            </thead>
            <tbody className="bg-white divide-y divide-gray-200">
              {paginatedComponents.length === 0 ? (
                <tr>
                  <td colSpan={6} className="px-4 py-8 text-center text-gray-500">
                    {searchTerm ? `No components match "${searchTerm}"` : 'No vulnerable components found'}
                  </td>
                </tr>
              ) : (
                paginatedComponents.map((component) => {
                  const criticalCount = component.vulnerabilities.filter(v => v.severity === 'critical').length;
                  return (
                    <tr key={`${component.package}@${component.version}`} className="hover:bg-gray-50">
                      <td className="px-4 py-4">
                        <div className="text-sm font-medium text-gray-900">{component.package}</div>
                      </td>
                      <td className="px-4 py-4 whitespace-nowrap">
                        <div className="text-sm text-gray-900">{component.version}</div>
                      </td>
                      <td className="px-4 py-4">
                        <div className="flex items-center gap-2">
                          <span className={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${
                            component.highestSeverity === 'critical' ? 'bg-red-100 text-red-800' :
                            component.highestSeverity === 'high' ? 'bg-orange-100 text-orange-800' :
                            component.highestSeverity === 'medium' ? 'bg-yellow-100 text-yellow-800' :
                            'bg-gray-100 text-gray-800'
                          }`}>
                            {component.highestSeverity}
                          </span>
                          <span className="text-xs text-gray-500">
                            {component.vulnerabilities.length} CVE{component.vulnerabilities.length !== 1 ? 's' : ''}
                          </span>
                        </div>
                        {criticalCount > 0 && (
                          <div className="text-xs text-red-600 mt-1">
                            🔴 {criticalCount} critical
                          </div>
                        )}
                      </td>
                      <td className="px-4 py-4">
                        <div className="text-sm text-gray-900">
                          {component.uniqueServices} service{component.uniqueServices !== 1 ? 's' : ''}
                        </div>
                        <div className="text-xs text-gray-500">
                          {Array.from(new Set(component.currentDeployments.map(d => d.serviceName)))
                            .slice(0, 2)
                            .join(', ')}
                          {component.uniqueServices > 2 && ` +${component.uniqueServices - 2} more`}
                        </div>
                      </td>
                      <td className="px-4 py-4">
                        <div className="text-sm text-gray-900">
                          {component.uniqueEnvironments} environment{component.uniqueEnvironments !== 1 ? 's' : ''}
                        </div>
                        <div className="text-xs text-gray-500 space-y-0.5 max-h-20 overflow-y-auto">
                          {component.currentDeployments.map(dep => (
                            <div key={`${dep.serviceId}-${dep.envId}`}>
                              {dep.envType === 'Production' ? '🔴' : '🔵'} {dep.envName} ({dep.serviceName})
                            </div>
                          ))}
                        </div>
                      </td>
                      <td className="px-4 py-4 whitespace-nowrap">
                        {getSBOMUrl(component) && (
                          <a
                            href={getSBOMUrl(component)!}
                            target="_blank"
                            rel="noopener noreferrer"
                            className="text-xs text-blue-600 hover:text-blue-800 underline"
                            title="View SBOM in Harness"
                          >
                            View SBOM
                          </a>
                        )}
                      </td>
                    </tr>
                  );
                })
              )}
            </tbody>
          </table>
        </div>

        {/* Pagination Controls */}
        {totalPages > 1 && (
          <div className="px-4 py-3 border-t border-gray-200 flex items-center justify-between">
            <button
              onClick={() => setCurrentPage(p => Math.max(1, p - 1))}
              disabled={currentPage === 1}
              className="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Previous
            </button>

            <div className="flex items-center gap-2">
              <span className="text-sm text-gray-700">
                Page {currentPage} of {totalPages}
              </span>
              <input
                type="number"
                min="1"
                max={totalPages}
                value={currentPage}
                onChange={(e) => {
                  const page = Number(e.target.value);
                  if (page >= 1 && page <= totalPages) {
                    setCurrentPage(page);
                  }
                }}
                className="w-20 px-2 py-1 border border-gray-300 rounded text-sm"
              />
            </div>

            <button
              onClick={() => setCurrentPage(p => Math.min(totalPages, p + 1))}
              disabled={currentPage === totalPages}
              className="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Next
            </button>
          </div>
        )}
      </div>
    </div>
  );
}
