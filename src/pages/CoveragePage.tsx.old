import { useState } from 'react';
import { useDashboardOverview } from '@/hooks/useHarnessData';
import { OrgProjectSelector } from '@/components/OrgProjectSelector';

export function CoveragePage() {
  const [orgId, setOrgId] = useState('demo');
  const [projectId, setProjectId] = useState('Platform_Engineering');

  const { data, isLoading, error } = useDashboardOverview(orgId, projectId);

  if (isLoading) {
    return (
      <div className="flex items-center justify-center h-64">
        <div className="text-center">
          <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-primary-600 mx-auto"></div>
          <p className="mt-4 text-gray-600">Loading coverage data...</p>
        </div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="space-y-4">
        <div className="card">
          <OrgProjectSelector
            selectedOrg={orgId}
            selectedProject={projectId}
            onOrgChange={setOrgId}
            onProjectChange={setProjectId}
          />
        </div>
        <div className="card bg-danger-50 border-danger-200">
          <h3 className="text-lg font-semibold text-danger-700 mb-2">Error Loading Coverage Data</h3>
          <p className="text-danger-600">{(error as Error).message}</p>
        </div>
      </div>
    );
  }

  if (!data) return null;

  const coverage = data.coverage;
  const instrumentedServices = coverage.totalServices - coverage.uninstrumentedServices.length;

  return (
    <div className="space-y-8">
      {/* Header */}
      <div>
        <h1 className="text-3xl font-bold text-gray-900">Coverage & Blind Spots</h1>
        <p className="mt-2 text-sm text-gray-600">
          Complete service inventory and instrumentation status
        </p>
      </div>

      {/* Org/Project Selector */}
      <div className="card">
        <OrgProjectSelector
          selectedOrg={orgId}
          selectedProject={projectId}
          onOrgChange={setOrgId}
          onProjectChange={setProjectId}
        />
      </div>

      {/* Coverage Overview */}
      <div className="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div className="card">
          <div className="text-sm font-medium text-gray-500 mb-2">Total Services</div>
          <div className="text-3xl font-bold text-gray-900">{coverage.totalServices}</div>
          <div className="text-xs text-gray-500 mt-1">In Harness inventory</div>
        </div>

        <div className="card bg-success-50 border-success-200">
          <div className="text-sm font-medium text-gray-500 mb-2">✅ Instrumented</div>
          <div className="text-3xl font-bold text-success-700">{instrumentedServices}</div>
          <div className="text-xs text-gray-500 mt-1">With deployment tracking</div>
        </div>

        <div className={`card ${coverage.coveragePercentage < 50 ? 'bg-danger-50 border-danger-200' : 'bg-warning-50 border-warning-200'}`}>
          <div className="text-sm font-medium text-gray-500 mb-2">❌ Blind Spots</div>
          <div className={`text-3xl font-bold ${coverage.coveragePercentage < 50 ? 'text-danger-700' : 'text-warning-700'}`}>
            {coverage.uninstrumentedServices.length}
          </div>
          <div className="text-xs text-gray-500 mt-1">No visibility</div>
        </div>

        <div className={`card ${coverage.coveragePercentage < 50 ? 'bg-danger-50 border-danger-200' : coverage.coveragePercentage < 80 ? 'bg-warning-50 border-warning-200' : 'bg-success-50 border-success-200'}`}>
          <div className="text-sm font-medium text-gray-500 mb-2">Coverage</div>
          <div className={`text-3xl font-bold ${coverage.coveragePercentage < 50 ? 'text-danger-700' : coverage.coveragePercentage < 80 ? 'text-warning-700' : 'text-success-700'}`}>
            {coverage.coveragePercentage}%
          </div>
          <div className="text-xs text-gray-500 mt-1">
            {coverage.coveragePercentage < 50 ? 'Critical' : coverage.coveragePercentage < 80 ? 'Needs improvement' : 'Good'}
          </div>
        </div>
      </div>

      {/* Core Principle Alert */}
      {coverage.coveragePercentage < 100 && (
        <div className={`card ${coverage.coveragePercentage < 50 ? 'bg-danger-50 border-danger-300' : 'bg-warning-50 border-warning-300'} border-2`}>
          <div className="flex items-start gap-4">
            <div className="flex-shrink-0 text-3xl">
              {coverage.coveragePercentage < 50 ? '🚨' : '⚠️'}
            </div>
            <div className="flex-1">
              <h3 className={`text-lg font-semibold mb-2 ${coverage.coveragePercentage < 50 ? 'text-danger-900' : 'text-warning-900'}`}>
                Core Principle: "Absence of evidence is NOT evidence of safety"
              </h3>
              <p className={`text-sm ${coverage.coveragePercentage < 50 ? 'text-danger-800' : 'text-warning-800'}`}>
                With {coverage.coveragePercentage}% coverage, <strong>{coverage.uninstrumentedServices.length} services</strong> have zero visibility.
                Any vulnerabilities in these services are invisible to this dashboard. This is a significant security blind spot.
              </p>
            </div>
          </div>
        </div>
      )}

      {/* Instrumented Services */}
      {instrumentedServices > 0 && (
        <div className="card bg-success-50 border-success-200">
          <h2 className="text-lg font-semibold text-success-900 mb-4">
            ✅ Instrumented Services ({instrumentedServices})
          </h2>
          <p className="text-sm text-success-800 mb-4">
            These services have active deployment tracking and vulnerability visibility.
          </p>
          <div className="text-sm text-success-700">
            View detailed vulnerability data on the <a href="/" className="font-semibold underline">Dashboard</a> or <a href="/exposures" className="font-semibold underline">Exposures</a> page.
          </div>
        </div>
      )}

      {/* Uninstrumented Services - Full Detail */}
      {coverage.uninstrumentedServices.length > 0 && (
        <div className={`card ${coverage.coveragePercentage < 50 ? 'bg-danger-50 border-danger-300' : 'bg-warning-50 border-warning-300'} border-2`}>
          <div className="flex items-center justify-between mb-6">
            <h2 className={`text-xl font-bold ${coverage.coveragePercentage < 50 ? 'text-danger-900' : 'text-warning-900'}`}>
              {coverage.coveragePercentage < 50 ? '🚨' : '⚠️'} Uninstrumented Services - Complete List
            </h2>
            <div className={`px-4 py-2 rounded-lg text-lg font-bold ${coverage.coveragePercentage < 50 ? 'bg-danger-200 text-danger-900' : 'bg-warning-200 text-warning-900'}`}>
              {coverage.uninstrumentedServices.length} Services
            </div>
          </div>

          {/* Action Items */}
          <div className="bg-white p-4 rounded-lg border-2 border-gray-300 mb-6">
            <h3 className="text-sm font-bold text-gray-900 mb-3">📋 Required Actions for Each Service:</h3>
            <ol className="list-decimal list-inside space-y-2 text-sm text-gray-800">
              <li><strong>Connect to Harness Pipeline:</strong> Ensure each service has a CI/CD pipeline configured in Harness</li>
              <li><strong>Enable SBOM Generation:</strong> Add SSCA/SCS step to generate Software Bill of Materials during build</li>
              <li><strong>Configure Artifact Tracking:</strong> Set up artifact repository integration (Docker, JFrog, etc.)</li>
              <li><strong>Add Deployment Verification:</strong> Add deployment steps that record to Harness with environment metadata</li>
              <li><strong>Validate Instrumentation:</strong> Run a test deployment and verify it appears in this dashboard</li>
            </ol>
          </div>

          {/* Service List Table */}
          <div className="bg-white rounded-lg border-2 border-gray-300 overflow-hidden">
            <div className="overflow-x-auto">
              <table className="min-w-full divide-y divide-gray-300">
                <thead className="bg-gray-100">
                  <tr>
                    <th className="px-4 py-3 text-left text-xs font-bold text-gray-900 uppercase tracking-wider">#</th>
                    <th className="px-4 py-3 text-left text-xs font-bold text-gray-900 uppercase tracking-wider">Service Name</th>
                    <th className="px-4 py-3 text-left text-xs font-bold text-gray-900 uppercase tracking-wider">Service ID</th>
                    <th className="px-4 py-3 text-left text-xs font-bold text-gray-900 uppercase tracking-wider">Status</th>
                    <th className="px-4 py-3 text-left text-xs font-bold text-gray-900 uppercase tracking-wider">Reason</th>
                  </tr>
                </thead>
                <tbody className="bg-white divide-y divide-gray-200">
                  {coverage.uninstrumentedServices.map((service, idx) => (
                    <tr key={service.serviceId} className="hover:bg-gray-50">
                      <td className="px-4 py-3 whitespace-nowrap text-sm font-medium text-gray-900">
                        {idx + 1}
                      </td>
                      <td className="px-4 py-3 whitespace-nowrap">
                        <div className="text-sm font-semibold text-gray-900">{service.serviceName}</div>
                      </td>
                      <td className="px-4 py-3 whitespace-nowrap">
                        <code className="text-xs bg-gray-100 px-2 py-1 rounded font-mono text-gray-700">
                          {service.serviceId}
                        </code>
                      </td>
                      <td className="px-4 py-3 whitespace-nowrap">
                        <span className={`inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold ${
                          coverage.coveragePercentage < 50 ? 'bg-danger-100 text-danger-800' : 'bg-warning-100 text-warning-800'
                        }`}>
                          ⚠️ No visibility
                        </span>
                      </td>
                      <td className="px-4 py-3 text-sm text-gray-600">
                        {service.reason}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          {/* Summary Footer */}
          <div className={`mt-6 p-4 rounded-lg ${coverage.coveragePercentage < 50 ? 'bg-danger-100' : 'bg-warning-100'}`}>
            <p className={`text-sm font-bold ${coverage.coveragePercentage < 50 ? 'text-danger-900' : 'text-warning-900'}`}>
              📊 Summary: {coverage.uninstrumentedServices.length} services ({100 - coverage.coveragePercentage}% of inventory) have zero security visibility.
              Until instrumented, vulnerabilities in these services cannot be detected or tracked.
            </p>
          </div>
        </div>
      )}

      {/* All Clear State */}
      {coverage.uninstrumentedServices.length === 0 && (
        <div className="card bg-success-50 border-success-300 border-2">
          <div className="flex items-center gap-4">
            <div className="text-4xl">✅</div>
            <div>
              <h2 className="text-xl font-bold text-success-900 mb-2">100% Coverage Achieved</h2>
              <p className="text-sm text-success-800">
                All {coverage.totalServices} services have deployment tracking and SBOM visibility.
                Continue monitoring the Dashboard for vulnerability exposures.
              </p>
            </div>
          </div>
        </div>
      )}

      {/* Data Freshness */}
      <div className="text-center text-sm text-gray-500">
        <p>
          Data freshness: {new Date(data.dataFreshness.lastFetchedAt).toLocaleString()}
          {' • '}
          Source: {data.dataFreshness.source === 'cache' ? 'Cached' : 'Live from Harness'}
        </p>
      </div>
    </div>
  );
}
